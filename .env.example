# When adding web environment variables, update apps/web/env.ts too.

# Local Compose PostgreSQL. Change the password before sharing a deployment.
POSTGRES_USER=hvac
POSTGRES_DB=hvac
POSTGRES_PASSWORD=local_hvac_dev_password
# Host-side pnpm commands use localhost; Compose overrides these URLs to the db service.
DATABASE_URL="postgresql://hvac:local_hvac_dev_password@localhost:5432/hvac"
DATABASE_DIRECT_URL="postgresql://hvac:local_hvac_dev_password@localhost:5432/hvac"

# Web
SITE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Host-side web uses localhost; Compose sets http://server:3001 for the web container.
HONO_INTERNAL_URL=http://localhost:3001
# Shared only by the Next.js server and Hono. Replace with a random value of at least 32 characters.
HONO_SERVICE_TOKEN=replace_with_a_long_random_service_token

# Auth
BETTER_AUTH_SECRET=thisisaverylongandsecuresecretstring
RESEND_API_KEY=re_123
# A verified platform sender for staff invitations, verification, and reset messages.
PLATFORM_FROM_EMAIL="HVAC Collections <staff@example.com>"
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

