# When adding web environment variables, update apps/web/env.ts too.

# Connect to Supabase via connection pooling with Supavisor.
DATABASE_URL="postgresql://localhost:5432/expo-starter"
# Direct connection to the database. Used for migrations.
DATABASE_DIRECT_URL="postgresql://localhost:5432/expo-starter"

# Web
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# Auth
BETTER_AUTH_SECRET=thisisaverylongandsecuresecretstring
RESEND_API_KEY=re_123

# Stripe web billing
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# RevenueCat mobile billing (optional)
# The iOS/Android SDK keys are public and bundled into the native app.
# EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_...
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_...
# The webhook cache uses server-only values.
# REVENUECAT_SECRET_API_KEY=sk_...
# REVENUECAT_PROJECT_ID=proj_...
# REVENUECAT_WEBHOOK_AUTH=Bearer replace-with-a-random-secret

# AI
# OPENAI_API_KEY=

# Sentry
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# PostHog
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Path to Google google-service-account-file.json
# GOOGLE_APPLICATION_CREDENTIALS=

# For use in prod instead of GOOGLE_APPLICATION_CREDENTIALS (See https://stackoverflow.com/a/77284609/5408068)
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_PRIVATE_KEY=
# GOOGLE_CLOUD_CLIENT_EMAIL=
