# When adding web environment variables, update apps/web/env.ts too.

# Runtime database URL. Local Postgres can connect directly; production Supabase should use the
# Supavisor transaction pooler on port 6543 with ?pgbouncer=true.
DATABASE_URL="postgresql://localhost:5432/expo-starter"
# Migration/admin URL. Use a direct connection or Supavisor session mode on port 5432.
DATABASE_DIRECT_URL="postgresql://localhost:5432/expo-starter"

# Web
SITE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Auth
BETTER_AUTH_SECRET=thisisaverylongandsecuresecretstring
RESEND_API_KEY=re_123
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# Stripe web billing
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# RevenueCat mobile billing (optional)
# The iOS/Android SDK keys are public and bundled into the native app.
# EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_...
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_...
# The webhook cache uses server-only values.
# REVENUECAT_SECRET_API_KEY=sk_...
# REVENUECAT_PROJECT_ID=proj_...
# REVENUECAT_WEBHOOK_AUTH=Bearer replace-with-a-random-secret

# AI
# OPENAI_API_KEY=

# Sentry
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# PostHog
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
