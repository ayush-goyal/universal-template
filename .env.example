# When adding additional environment variables, the schema in "apps/web/env.ts"
# should be updated accordingly.

# Connect to Supabase via connection pooling with Supavisor.
DATABASE_URL="postgresql://localhost:5432/expo-starter"
# Direct connection to the database. Used for migrations.
DATABASE_DIRECT_URL="postgresql://localhost:5432/expo-starter"

# Web
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# Auth
BETTER_AUTH_SECRET=thisisaverylongandsecuresecretstring
# Custom scheme the Expo app registers, mirroring expo.scheme in apps/native/app.json.
# Better Auth must trust it or mobile sign-in redirects are rejected.
# EXPO_APP_SCHEME=expoboilerplate
# Leave unset in development and verification / password-reset emails print to the console.
# RESEND_API_KEY=re_123

# Google OAuth. Both must be set or the provider is skipped.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# AI
# OPENAI_API_KEY=

# Billing — Stripe (web).
# Test keys from https://dashboard.stripe.com/test/apikeys. Create a Pro product with a monthly and
# an annual price, then paste the price IDs here; a plan with no price is hidden from checkout.
# Webhook secret comes from `stripe listen --forward-to localhost:3000/api/auth/stripe/webhook`.
# STRIPE_SECRET_KEY=sk_test_
# STRIPE_WEBHOOK_SECRET=whsec_
# STRIPE_PRO_MONTHLY_PRICE_ID=price_
# STRIPE_PRO_ANNUAL_PRICE_ID=price_

# Billing — RevenueCat (iOS and Android).
# The webhook endpoint is /api/webhooks/revenuecat. Without a signing secret or an auth header it
# rejects every delivery, because an unauthenticated caller could otherwise grant themselves Pro.
# The secret API key is optional: with it, each webhook re-reads the customer from RevenueCat
# (their recommendation) instead of deriving state from the event payload alone.
# REVENUECAT_SECRET_API_KEY=sk_
# REVENUECAT_WEBHOOK_SIGNING_SECRET=
# REVENUECAT_WEBHOOK_AUTH_HEADER=

# Sentry
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# PostHog
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Path to Google google-service-account-file.json
# GOOGLE_APPLICATION_CREDENTIALS=

# For use in prod instead of GOOGLE_APPLICATION_CREDENTIALS (See https://stackoverflow.com/a/77284609/5408068)
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_PRIVATE_KEY=
# GOOGLE_CLOUD_CLIENT_EMAIL=
