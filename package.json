{
  "name": "@acme/root",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0",
    "pnpm": ">=9.6.0"
  },
  "packageManager": "pnpm@10.6.3",
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run format lint typecheck test --affected --continue",
    "check:all": "turbo run format lint typecheck test --continue",
    "clean": "turbo run clean && rm -rf node_modules",
    "dev": "turbo watch dev --continue",
    "fix": "turbo run lint:fix --affected --continue && turbo run format:fix --affected --continue",
    "fix:all": "turbo run lint:fix --continue && turbo run format:fix --continue",
    "format": "turbo run format --continue",
    "format:fix": "turbo run format:fix --continue",
    "lint": "turbo run lint --continue",
    "lint:fix": "turbo run lint:fix --continue",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "verify": "pnpm fix && pnpm check",
    "verify:all": "pnpm fix:all && pnpm check:all",
    "prepare": "husky"
  },
  "devDependencies": {
    "@acme/prettier-config": "workspace:*",
    "@turbo/gen": "^2.9.7",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "prettier": "catalog:",
    "turbo": "^2.9.7",
    "typescript": "catalog:"
  },
  "prettier": "@acme/prettier-config",
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": "oxlint --fix",
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,yml,yaml,css,html,md}": "prettier --write"
  }
}
