{
  "name": "@acme/auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./stripe": "./src/stripe.ts"
  },
  "license": "MIT",
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "format:fix": "prettier --write . --ignore-path ../../.gitignore",
    "lint": "oxlint --config ../../.oxlintrc.json --type-aware .",
    "lint:fix": "oxlint --config ../../.oxlintrc.json --type-aware --fix .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@acme/db": "workspace:*",
    "@acme/shared": "workspace:*",
    "@better-auth/expo": "catalog:",
    "@better-auth/stripe": "catalog:",
    "better-auth": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-email": "^6.11.6",
    "resend": "^6.37.0",
    "stripe": "^22.6.2",
    "twilio": "^6.2.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@acme/prettier-config": "workspace:*",
    "@acme/tsconfig": "workspace:*",
    "@acme/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "dotenv-cli": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "prettier": "@acme/prettier-config"
}
