{
  "name": "@acme/auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./email": "./src/email.ts",
    "./permissions": "./src/permissions.ts"
  },
  "license": "MIT",
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "format:fix": "prettier --write . --ignore-path ../../.gitignore",
    "lint": "oxlint --config ../../.oxlintrc.json --type-aware .",
    "lint:fix": "oxlint --config ../../.oxlintrc.json --type-aware --fix .",
    "platform:bootstrap": "pnpm with-env tsx src/bootstrap-platform.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@acme/db": "workspace:*",
    "@react-email/components": "^1.0.2",
    "better-auth": "catalog:",
    "react": "catalog:",
    "react-email": "^5.1.0",
    "resend": "^6.6.0",
    "twilio": "^5.11.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@acme/prettier-config": "workspace:*",
    "@acme/tsconfig": "workspace:*",
    "@acme/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "dotenv-cli": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "prettier": "@acme/prettier-config"
}
