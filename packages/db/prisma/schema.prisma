generator client {
  provider = "prisma-client"
  output   = "./generated/client"
  runtime  = "nodejs"
}

generator workerd {
  provider      = "prisma-client"
  output        = "./generated/workerd"
  runtime       = "workerd"
  compilerBuild = "small"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String       @id @default(uuid())
  name                String
  email               String
  emailVerified       Boolean
  image               String?
  createdAt           DateTime
  updatedAt           DateTime
  phoneNumber         String?
  phoneNumberVerified Boolean?
  isPlatformAdmin     Boolean      @default(false)
  sessions            Session[]
  accounts            Account[]
  devices             Device[]
  memberships         Member[]
  invitationsSent     Invitation[]

  @@unique([email])
  @@unique([phoneNumber])
  @@map("user")
}

enum DevicePlatform {
  IOS
  ANDROID
}

model Device {
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  fcmToken  String
  platform  DevicePlatform
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@id([userId, fcmToken])
  @@map("devices")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime
  updatedAt            DateTime
  ipAddress            String?
  userAgent            String?
  userId               String
  activeOrganizationId String?
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

// These three models use Better Auth's organization plugin field names.
model Organization {
  id          String           @id
  name        String
  slug        String           @unique
  logo        String?
  metadata    String?
  createdAt   DateTime
  members     Member[]
  invitations Invitation[]
  settings    CompanySettings?
  cases       CollectionCase[]
  calls       CallSession[]
  emails      EmailMessage[]

  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  userId         String
  role           String
  createdAt      DateTime
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  email          String
  inviterId      String
  organizationId String
  role           String?
  status         String
  createdAt      DateTime
  expiresAt      DateTime
  inviter        User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, email, status])
  @@map("invitation")
}

// One row per company. Policy history and sender setup are small JSON objects.
model CompanySettings {
  organizationId String       @id
  displayName    String
  callbackPhone  String?
  policyMarkdown String       @default("")
  policyVersion  Int          @default(0)
  policyHistory  Json         @default("[]")
  senderConfig   Json         @default("{}")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("company_settings")
}

// Stable customer, invoice, service, and contact facts are queryable columns.
// caseData holds the active payment arrangement and any unrecognized legacy metadata.
model CollectionCase {
  id                String         @id @default(uuid())
  organizationId    String
  customerName      String
  invoiceNumber     String
  outstandingAmount Decimal        @db.Decimal(12, 2)
  originalAmount    Decimal?       @db.Decimal(12, 2)
  customerType      String?
  billingEmail      String?
  phone             String?
  invoiceDate       String?
  serviceDate       String?
  serviceDescription String?
  authorizedContactName String?
  authorizedContactRole String?
  preferredContactMethod String @default("email")
  assignedAgentId   String?
  doNotEmail        Boolean        @default(false)
  doNotCall         Boolean        @default(false)
  currency          String         @default("USD")
  status            String         @default("ready")
  caseData          Json           @default("{}")
  notes             String         @default("")
  followUp          Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  calls             CallSession[]
  emails            EmailMessage[]
  timelineEvents    CaseTimelineEvent[]

  @@unique([organizationId, id])
  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, status])
  @@index([organizationId, assignedAgentId])
  @@map("collection_cases")
}

model CaseTimelineEvent {
  id             String         @id @default(uuid())
  organizationId String
  caseId         String
  type           String
  summary        String
  occurredAt     DateTime
  details        Json           @default("{}")
  collectionCase CollectionCase @relation(fields: [organizationId, caseId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId, caseId, occurredAt])
  @@map("case_timeline_events")
}

// One row per call holds the text transcript, API results, and final outcome.
// An activeCaseId is set only while the call owns that case's live-call slot.
model CallSession {
  id                  String         @id @default(uuid())
  organizationId      String
  caseId              String
  actorUserId         String
  policyVersion       Int
  policySnapshot      String
  providerSessionId   String?        @unique
  startIdempotencyKey String?
  activeCaseId        String?
  connectionState     String         @default("pending")
  sessionData         Json           @default("{}")
  transcriptText      String         @default("")
  apiResults          Json           @default("[]")
  outcomeKind         String?
  outcomeData         Json?
  summary             String?
  startedAt           DateTime       @default(now())
  endedAt             DateTime?
  updatedAt           DateTime       @updatedAt
  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  collectionCase      CollectionCase @relation(fields: [organizationId, caseId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@unique([organizationId, activeCaseId])
  @@unique([organizationId, startIdempotencyKey])
  @@index([organizationId, caseId, startedAt])
  @@map("call_sessions")
}

// One row per customer email doubles as a small durable send queue.
model EmailMessage {
  id                String         @id @default(uuid())
  organizationId    String
  caseId            String
  callId            String?
  eventKey          String
  recipient         String
  fromAddress       String
  subject           String
  body              String
  status            String         @default("queued")
  providerMessageId String?
  latestError       String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  collectionCase    CollectionCase @relation(fields: [organizationId, caseId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, eventKey])
  @@index([organizationId, caseId, createdAt])
  @@index([status, createdAt])
  @@map("email_messages")
}
