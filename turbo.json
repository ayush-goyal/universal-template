{
  "$schema": "https://turborepo.dev/schema.v2.json",
  "ui": "tui",
  "envMode": "loose",
  "globalDependencies": [".env"],
  "tasks": {
    "topo": {
      "dependsOn": ["^topo"]
    },
    "generate": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": [".cache/tsbuildinfo.json", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "format": {
      "outputLogs": "errors-only"
    },
    "format:fix": {
      "cache": false
    },
    "lint": {
      "dependsOn": ["^topo", "^build"]
    },
    "lint:fix": {
      "dependsOn": ["^topo", "^build"],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^topo", "^build"],
      "outputs": [".cache/tsbuildinfo.json"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
