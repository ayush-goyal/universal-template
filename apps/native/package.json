{
  "name": "@acme/native",
  "version": "0.1.0",
  "private": true,
  "main": "index.tsx",
  "scripts": {
    "adb": "adb reverse tcp:9090 tcp:9090 && adb reverse tcp:3000 tcp:3000 && adb reverse tcp:9001 tcp:9001 && adb reverse tcp:8081 tcp:8081",
    "android": "expo run:android",
    "build:ios": "dotenv -- eas build -p ios --profile production --local",
    "build:android": "dotenv -- eas build -p android --profile production --local",
    "clean": "git clean -xdf .cache .expo .turbo android ios node_modules",
    "compile": "pnpm --dir ../.. exec tsc --noEmit -p apps/native --pretty",
    "dev": "expo start",
    "dev:mcp": "EXPO_UNSTABLE_MCP_SERVER=1 expo start --dev-client",
    "ios": "expo run:ios",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "format:fix": "prettier --write . --ignore-path ../../.gitignore",
    "lint": "oxlint --config ../../.oxlintrc.json --type-aware .",
    "lint:fix": "oxlint --config ../../.oxlintrc.json --type-aware --fix .",
    "patch": "patch-package",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "serve:web": "npx serve dist",
    "start": "expo start --dev-client",
    "submit:ios": "eas submit --profile production --platform ios --path",
    "submit:android": "eas submit --profile production --platform android --path",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:e2e": "pnpm test:e2e:ios",
    "test:e2e:android": "SENTRY_DISABLE_AUTO_UPLOAD=true expo run:android --variant release --no-bundler && pnpm test:e2e:run",
    "test:e2e:ios": "LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 SENTRY_DISABLE_AUTO_UPLOAD=true expo run:ios --configuration Release --no-bundler && pnpm test:e2e:run",
    "test:e2e:run": "maestro test .maestro --include-tags=smoke",
    "test:watch": "jest --watch",
    "typecheck": "pnpm --dir ../.. exec tsc --noEmit -p apps/native",
    "web": "expo start --web"
  },
  "dependencies": {
